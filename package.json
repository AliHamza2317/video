{
  "name": "hostastic-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Hostastic explainer video (~76s, 7 scenes), built as code with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render HostasticExplainer out/hostastic-explainer.mp4",
    "render:clean": "remotion render HostasticExplainerNoCaptions out/hostastic-explainer-no-captions.mp4",
    "still": "remotion still HostasticExplainer out/poster.png --frame=2250",
    "captions": "node --no-warnings scripts/export-captions.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@remotion/cli": "4.0.527",
    "@remotion/fonts": "4.0.527",
    "@remotion/transitions": "4.0.527",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
